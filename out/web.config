<?xml version="1.0" encoding="utf-8"?>
<!-- Sadece varsayilan belge; system.web YOK (ASP.NET compilation tetiklenmesin) -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <add value="index.html" />
        <add value="default.htm" />
        <add value="index.htm" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
